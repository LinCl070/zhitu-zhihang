# Do not place production keys, resumes, or real student information in this file.
APP_ENV=development
APP_NAME=Career Navigator API
APP_ORIGIN=http://localhost:5173
DATABASE_URL=
# Required only when running `python -m scripts.bootstrap_admin` for the first administrator.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional. Shared password for demo_teacher and the six synthetic students created by
# `python -m scripts.seed_governance_demo`.
DEMO_ACCOUNT_PASSWORD=
FASTGPT_MODE=mock
FASTGPT_BASE_URL=
# The route-specific keys are preferred. FASTGPT_API_KEY remains a legacy fallback.
FASTGPT_API_KEY=
FASTGPT_API_KEY_CAREER=
FASTGPT_API_KEY_POLICY=
FASTGPT_CHAT_COMPLETIONS_PATH=/api/v1/chat/completions
FASTGPT_WORKFLOW_CAREER_ID=
FASTGPT_WORKFLOW_POLICY_ID=
